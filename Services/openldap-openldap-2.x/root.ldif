# Build the root node.
dn: dc=DOMAIN_NAME_PART_A,dc=DOMAIN_NAME_PART_B
objectclass: dcObject
objectClass: organization
dc: DOMAIN_NAME_PART_A
o: ORGANIZATION_NAME

# Build the people branch.
dn: ou=People,dc=DOMAIN_NAME_PART_A,dc=DOMAIN_NAME_PART_B
objectClass: organizationalUnit
ou: People

# Build the group branch.
dn: ou=Groups,dc=DOMAIN_NAME_PART_A,dc=DOMAIN_NAME_PART_B
objectClass: organizationalUnit
ou: Groups

