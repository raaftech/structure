# hostctl.conf
#
# This file controls which Bind and DHCPd config files hostctl will edit.
# Usually these are Universal variables. TARGET_ROOT means hostctl will work
# with the generated Bind and DHCPd configuration under the Universal target
# Directory. To make hostctl work with a "live" configuration that has been
# installed by Universal, it is usually sufficient to simply remove the
# TARGET_ROOT variable from the values below.

DHCP3_ROOT="$TARGET_ROOT/$DHCP3_CONFIG_DIRECTORY"
BIND9_ROOT="$TARGET_ROOT/$BIND9_DATA_DIRECTORY"
TFTP1_ROOT="$TARGET_ROOT/$TFTP1_DATA_DIRECTORY"
TFTP_KNOWN_BOOTFILES="pxelinux.0 pxeboot pxegrub pxeboot_ia32.bin pxeboot_tftp"

