{
  "additionalProperties": false,
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "country": {
      "type": "string",
      "description": "The country where the Building resides"
    },
    "code": {
      "$ref": "locational.schema.json#/properties/code"
    },
    "city": {
      "type": "string",
      "description": "The city where the Building resides."
    },
    "streetAddress": {
      "type": "string",
      "description": "The street address and number (if any) of the Building."
    },
    "postalCode": {
      "type": "string",
      "description": "'The postal code or the Building."
    },
    "name": {
      "$ref": "type.schema.json#/properties/name"
    },
    "desc": {
      "$ref": "type.schema.json#/properties/desc"
    }
  },
  "required": [
    "name",
    "desc",
    "city",
    "streetAddress",
    "country"
  ]
}