{
  "additionalProperties": false,
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "name": {
      "$ref": "type.schema.json#/properties/name"
    },
    "addr": {
      "type": "string",
      "pattern": "^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$",
      "description": "IP addresses should at least have the addr field."
    },
    "reachable": {
      "type": "boolean",
      "description": "Is this IP address reachable from the outside?"
    },
    "desc": {
      "$ref": "type.schema.json#/properties/desc"
    }
  },
  "required": [
    "name",
    "desc",
    "addr",
    "reachable"
  ]
}