{
    "labels": [ "Node", "TypeNode" ],
    "properties": {
        "name": "OpenSSHClient",
       	"desc": "The OpenSSH client software.",
        "uuid": "4faa3819-d9b7-4196-b884-77e247d0ffdc",
        "link": {
            "icon": {
                "type": "icon",
                "mime": "application/font-sfnt",
                "href": "/img/font/structureglyph.ttf#0x00dd"
            }
	    },
	    "caps": {
	    	"openssh-sendString": {
		        "capability": "sendString",
		        "appliesTo": [ "OpenSshClient" ],
		        "template": "opensshclient-sendstring.hbs",
		        "subjectIsLocal": false,
		        "weight": 90,
		        "arguments": {
		        	"addr": {
		        		"value": {
		        			"from": "subject" //where to find the type: static, agent or subject? 
		        			"data": "type.configuration.ipaddress.ipv4address", //what we're looking for
		        			"matches": { "desc": "some regexp", "addr": "some other regexp" }, //optional
		        			"strategy": "useFirst|useLast|mustBeOne|mustBeMany", //determines result behaviour
		        			"onError": "fail, askUser, ignore" //what to do if strategy fails
		        		},
		        		"canBeUserSupplied": false,
		        		"isOptional": false
		        	},
		        	"user": {
		        		"value": {
		        			"from": "subject"
		        			"data": "type.configuration.actor.user",
		        			"matches": { "role": "Administrator" }, 
		        			"strategy": "mustBeOne",
		        			"onError": "askUser"
		        		},
		        		"canBeUserSupplied": false, //??
		        		"isOptional": false
		        	},
		        	"cmdString": {
		        		"value": {
		        			"from": "static"
		        			"data": "echo 'no command string passed to execute'",
		        		},
		        		"canBeUserSupplied": true, //instrumentsupplied?
		        		"isOptional": false
		        	}
		        }
            }
	    },
        "relations": {
            "IS_A": "SSHClient"
        }
    }
}
