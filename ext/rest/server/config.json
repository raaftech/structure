{
  "restApiRoot": "/api",
  "remoting": {
    "context": false,
    "rest": {
      "normalizeHttpPath": false,
      "xml": false
    },
    "json": {
      "strict": false,
      "limit": "100kb"
    },
    "urlencoded": {
      "extended": true,
      "limit": "100kb"
    },
    "cors": false,
    "handleErrors": false,
    "errorHandler": {
      "disableStackTrace": true
    }
  },
  "legacyExplorer": false,
  "logoutSessionsOnSensitiveChanges": true
}
