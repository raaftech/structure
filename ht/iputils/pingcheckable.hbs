{{!

{
  "name": "IputilsPingCheckable",
  "desc": "Provide a check to IP addresses using ping.",
  "instrumentType": "runner",
  "capability": "State",
  "providedBy": "Iputils",
  "appliesTo": [ "Ipv4Address" ],
  "subjectIsLocal": false,
  "arguments": {
    "ipv4address": {
      "value": {
        "from": "origin",
        "type": "type.configuration.ipaddress.ipv4address",
        "strategy": "useFirst",
        "onError": "fail"
      },
      "canBeUserSupplied": false,
      "isOptional": false
    },
    "interval": {
      "value": {
        "from": "static",
        "type": "string",
        "matches": "[0-9]+",
        "strategy": "mustBeOne"
      },
      "canBeUserSupplied": true,
      "isOptional": true
    },
    "count": {
      "value": {
        "from": "static",
        "type": "string",
        "matches": "[0-9]+",
        "data": "4",
        "strategy": "mustBeOne"
      },
      "canBeUserSupplied": true,
      "isOptional": true
    },
    "timeout": {
      "value": {
        "from": "static",
        "type": "string",
        "matches": "[0-9]+",
        "strategy": "mustBeOne"
      },
      "canBeUserSupplied": true,
      "isOptional": true
    }
  }
}

}}
ping {{#if count}}"-c {{count}}" {{/if}}{{#if interval}}"-i {{interval}}" {{/if}}{{#if timeout}}"-W {{timeout}}" {{/if}}{{ origin.addr }}
