{{!

{
  "name": "check",
  "desc": "LaunchdCheck",
  "instrumentType": "runner",
  "capability": "State",
  "providedBy": "Launchd",
  "appliesTo": [ "Server" ],
  "subjectIsLocal": true,
  "arguments": {
    "origin": {
      "value": {
        "from": "origin",
        "type": "type.component.software.server",
        "strategy": "mustBeOne",
        "onError": "fail"
      },
      "canBeUserSupplied": false,
      "isOptional": false
    }
  }
}

}}
launchctl list {{ origin.shortName }} &>/dev/null && printf on || printf off
