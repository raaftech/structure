{{!

{
  "name": "OpenSshClientSendFile",
  "desc": "The handler that provides the SendFile capability to the OpenSSH client.",
  "instrumentType": "runner",
  "capability": "SendFile",
  "providedBy": "OpenSshClient",
  "appliesTo": [ "OpenSshClient" ],
  "subjectIsLocal": false,
  "weight": 90,
  "arguments": {
    "ipv4address": {
      "value": {
        "from": "subject",
        "type": "type.configuration.ipaddress.ipv4address",
        "strategy": "useFirst",
        "onError": "fail"
      },
      "canBeUserSupplied": false,
      "isOptional": false
    },
    "payloadDirectory": {
      "value": {
        "from": "static",
        "type": "string",
        "strategy": "mustBeOne"
      },
      "canBeUserSupplied": false,
      "isOptional": false
    },
    "payloadFileName": {
      "value": {
        "from": "static",
        "type": "string",
        "strategy": "mustBeOne"
      },
      "canBeUserSupplied": false,
      "isOptional": false
    },
    "username": {
      "value": {
        "from": "static",
        "type": "string",
        "defaultValue": "root",
        "strategy": "mustBeOne"
      },
      "canBeUserSupplied": true,
      "isOptional": true
    }
  }
}

}}
scp {{{ payloadDirectory }}}{{{ payloadFileName }}} {{{username}}}@{{{ ipv4address.addr }}}:/tmp/
