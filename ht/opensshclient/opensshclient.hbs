{{!

{
  "name": "OpenSSHClientScriptable",
  "desc": "The handler that provides the scriptable capability to the OpenSSH client.",
  "capability": "Scriptable",
  "providedBy": "OpenSshClient",
  "appliesTo": [ "OpenSshClient" ],
  "subjectIsLocal": false,
  "weight": 90,
  "arguments": {
    "non-interactive": {
      "root": [
        "payload"
      ],
      "group": [
        "type.configuration.ipaddress.ipv4address"
      ]
    },
    "interactive": {
      "optional": [
        "payload"
      ]
    }
  }
}

}}
scp {{ payload.absolute }} root@{{ reachable group.Ipv4Address }}:/tmp/
ssh -lroot {{ reachable group.Ipv4Address }} "chmod +x /tmp/{{ payload.filename }} && /tmp/{{ payload.filename }}"
