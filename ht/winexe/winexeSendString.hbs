{{!

{
  "name": "WinexeSendString",
  "desc": "The handler that provides the SendString capability to winese.",
  "instrumentType": "runner",
  "capability": "SendString",
  "providedBy": "Winexe",
  "appliesTo": [ "Winexe" ],
  "subjectIsLocal": false,
  "weight": 90,
  "arguments": {
    "ipv4address": {
      "value": {
        "from": "subject",
        "type": "type.configuration.ipaddress.ipv4address",
	"matches": { "reachable": "true" },
        "strategy": "useFirst",
        "onError": "fail"
      },
      "canBeUserSupplied": false,
      "isOptional": false
    },
    "payloadDirectory": {
      "value": {
        "from": "static",
        "type": "string",
        "strategy": "mustBeOne"
      },
      "canBeUserSupplied": false,
      "isOptional": false
    },
    "payloadFileName": {
      "value": {
        "from": "static",
        "type": "string",
        "strategy": "mustBeOne"
      },
      "canBeUserSupplied": false,
      "isOptional": false
    },
    "username": {
      "value": {
        "from": "static",
        "type": "string",
        "data": "structure",
        "strategy": "mustBeOne"
      },
      "canBeUserSupplied": true,
      "isOptional": true
    },
    "password": {
      "value": {
        "from": "static",
        "type": "string",
	"data": "Structure1!_",
        "strategy": "mustBeOne"
      },
      "canBeUserSupplied": true,
      "isOptional": true
    }
  }
}

}}
winexe --user={{ username }}%{{ password }} //{{ ipv4address.addr }} "C:\Windows\temp\{{ payloadFileName }}"
