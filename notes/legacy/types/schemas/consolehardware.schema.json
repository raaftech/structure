{
  "additionalProperties": false,
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "baudRate": {
      "type": "number",
      "description": "110,300,600,1200,2400,4800,9600,14400,19200,28800,38400,56000,57600 or 115200."
    },
    "rev": {
      "$ref": "hardware.schema.json#/properties/rev"
    },
    "stopBits": {
      "type": "number",
      "description": "1, 1.5 or 2."
    },
    "parity": {
      "type": "string",
      "description": "none (N)); odd (O), even (E), mark (M), or space (S)."
    },
    "name": {
      "$ref": "type.schema.json#/properties/name"
    },
    "dataBits": {
      "type": "number",
      "description": "5,6,7,8 or 9."
    },
    "desc": {
      "$ref": "type.schema.json#/properties/desc"
    }
  },
  "required": ["name", "desc"]
}
