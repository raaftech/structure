# netbsd-4-i386.desc - NetBSD 4.x i386 Platform Descriptor


# Used by Tools/sanity
SANITY_DO_CONFIGURATION="1"         # Do a sanity check before attempting any
                                    # other steps. Don't touch this unless you
                                    # know what you're doing.

# Used by Tools/networking
NETWORKING_DO_CONFIGURATION="0"     # Install networking using settings from
                                    # Configuration/setup.conf. If set to "0",
                                    # no setup will be done; currently running
                                    # settings will be used instead.

# Used by Tools/packaging
PACKAGING_DO_CONFIGURATION="0"      # Install additional packaging configs on
                                    # this platform. This is usually needed 
                                    # when not all software dependencies can be
                                    # met by the default software installation
                                    # methods available. If set to "0", no 
                                    # setup will be done; currently running
                                    # settings will be used instead.

# Used by Tools/certificates
CERTIFICATES_DO_CONFIGURATION="1"   # Install and generate certificates for the
                                    # specified servername & requested services.
                                    # If set to "0", no certificates will be
                                    # generated. Don't touch this unless you
                                    # know what you're doing.

# Used by Tools/utilities
UTILITIES_DO_CONFIGURATION="0"      # Install and generate utilities which aid
                                    # in administration of a server. Don't touch
                                    # this unless you know what you're doing.


# Platform Globals
PLATFORM_INIT_TYPE="bsd"
PLATFORM_INIT_DIRECTORY="/etc/rc.d"
PLATFORM_MAC_TYPE=""
PLATFORM_FW_TYPE="ipf"


# Used by Tools/packaging
PACKAGING_PACKAGES_REQUIRED="0"
PACKAGING_PACKAGES_LISTING="pkgtools/pkg_install"
PACKAGING_DISTRIBUTION_TYPE="cvs"
PACKAGING_CONFIG_DIRECTORY="/usr/pkgsrc"
PACKAGING_REPOSITORY_LIST="pkgsrc"

# Used by Tools/certificates
CERTIFICATES_PACKAGES_REQUIRED="0"
CERTIFICATES_PACKAGES_LISTING="openssl"
CERTIFICATES_CONFIG_DIRECTORY="/etc/openssl"
CERTIFICATES_DATA_DIRECTORY="/etc/openssl/certs"

# Used by Tools/utilities
UTILITIES_PACKAGES_REQUIRED="0"
UTILITIES_PACKAGES_LISTING="sh"
UTILITIES_CONFIG_DIRECTORY="/usr/sbin"      

# Used by Services/dns/bind9
BIND9_PACKAGES_REQUIRED="0"
BIND9_PACKAGES_LISTING="named"
BIND9_SERVICE_DEPS=""
BIND9_CONFIG_DIRECTORY="/etc"
BIND9_DATA_DIRECTORY="/etc/namedb"
BIND9_INIT_SCRIPTS="named"
BIND9_INIT_CONFIG=""
BIND9_INIT_STRING=""

# Used by Services/dhcp/dhcp3
DHCP3_PACKAGES_REQUIRED="0"
DHCP3_PACKAGES_LISTING="dhcpd"
DHCP3_SERVICE_DEPS=""
DHCP3_CONFIG_DIRECTORY="/etc"
DHCP3_DATA_DIRECTORY="/var/db"
DHCP3_INIT_SCRIPTS="dhcpd"
DHCP3_INIT_CONFIG=""
DHCP3_INIT_STRING=""

# Used by Services/tftp/tftp1
TFTP1_PACKAGES_REQUIRED="0"
TFTP1_PACKAGES_LISTING="tftpd"
TFTP1_SERVICE_DEPS="dhcp(dhcp3)"
TFTP1_CONFIG_DIRECTORY="/etc"
TFTP1_DATA_DIRECTORY="/var/tftpboot"
TFTP1_INETD_TYPE="inetd"
TFTP1_INIT_SCRIPTS="inetd"
TFTP1_INIT_CONFIG=""
TFTP1_INIT_STRING=""

# Used by Services/ntp/ntp4
NTP4_PACKAGES_REQUIRED="0"
NTP4_PACKAGES_LISTING="ntpd"
NTP4_SERVICE_DEPS=""
NTP4_CONFIG_DIRECTORY="/etc"
NTP4_DATA_DIRECTORY="/var/ntp"
NTP4_LOGGING_DIRECTORY="/var/log"
NTP4_INIT_SCRIPTS="ntpd"
NTP4_INIT_CONFIG=""
NTP4_INIT_STRING=""

# Used by Services/smtp/postfix2
POSTFIX2_PACKAGES_REQUIRED="0"
POSTFIX2_PACKAGES_LISTING=""
POSTFIX2_SERVICE_DEPS="sasl(dovecot1)"
POSTFIX2_CONFIG_DIRECTORY="/etc/postfix"
POSTFIX2_COMMAND_DIRECTORY="/usr/sbin"
POSTFIX2_DAEMON_DIRECTORY="/usr/libexec/postfix"
POSTFIX2_QUEUE_DIRECTORY="/var/spool/postfix"
POSTFIX2_ALIASES_FILE="/etc/mail/aliases"
POSTFIX2_SETGID_GROUP="maildrop"
POSTFIX2_SASL_TYPE="dovecot"
POSTFIX2_SASL_PATH="private/auth"
POSTFIX2_INIT_SCRIPTS="postfix"
POSTFIX2_INIT_CONFIG=""
POSTFIX2_INIT_STRING=""

# Used by Services/sasl/cyrus2
CYRUS2_PACKAGES_REQUIRED="1"
CYRUS2_PACKAGES_LISTING="security/cyrus-saslauthd"
CYRUS2_CONFIG_DIRECTORY="/usr/pkg/etc"
CYRUS2_INIT_SCRIPTS="saslauthd"
CYRUS2_INIT_CONFIG=""
CYRUS2_INIT_STRING=""

# Used by Services/[imap4 pop3 sasl]/dovecot1
DOVECOT1_PACKAGES_REQUIRED="1"
DOVECOT1_PACKAGES_LISTING="mail/dovecot"
DOVECOT1_CONFIG_DIRECTORY="/usr/pkg/etc"
DOVECOT1_INIT_SCRIPTS="dovecot"
DOVECOT1_INIT_CONFIG=""
DOVECOT1_INIT_STRING=""

# Used by Services/ldap/openldap2
OPENLDAP2_PACKAGES_REQUIRED="1"
OPENLDAP2_PACKAGES_LISTING="databases/openldap databases/nss_ldap security/pam-ldap"
OPENLDAP2_SERVICE_DEPS=""
OPENLDAP2_CONFIG_DIRECTORY="/usr/pkg/etc/openldap"
OPENLDAP2_DATA_DIRECTORY="/var/openldap/openldap-data"
OPENLDAP2_STATE_DIRECTORY="/var/openldap/run"
OPENLDAP2_MODULES_DIRECTORY="/usr/pkg/lib/openldap"
OPENLDAP2_MODULAR_BACKEND="0"
OPENLDAP2_DAEMON_USER="slapd"
OPENLDAP2_DAEMON_GROUP="ldap"
OPENLDAP2_BACKEND_TYPE="bdb"
OPENLDAP2_INIT_SCRIPTS="slapd"
OPENLDAP2_INIT_CONFIG="/etc/rc.conf.d/slapd"
OPENLDAP2_INIT_STRING='slapd_flags="-h \"ldap:/// ldaps:///\""'

# Used by Services/nfs/nfs3
NFS3_PACKAGES_REQUIRED="0"
NFS3_PACKAGES_LISTING=""
NFS3_SERVICE_DEPS=""
NFS3_CONFIG_DIRECTORY="/etc"
NFS3_DATA_DIRECTORY="/var/public"
NFS3_INIT_SCRIPTS="rpcbind mountd nfsd"
NFS3_INIT_CONFIG="/etc/rc.conf.d/nfsd"
NFS3_INIT_STRING='nfs_server=YES'

# Used by Services/smb/samba3
SAMBA3_PACKAGES_REQUIRED="1"
SAMBA3_PACKAGES_LISTING="net/samba"
SAMBA3_SERVICE_DEPS=""
SAMBA3_CONFIG_DIRECTORY="/usr/pkg/etc/samba"
SAMBA3_DATA_DIRECTORY="/var/public"
SAMBA3_LOGGING_DIRECTORY="/var/log"
SAMBA3_SPOOLER_DIRECTORY="/var/spool/samba"
SAMBA3_NETLOGON_DIRECTORY="/var/samba/netlogon"
SAMBA3_PROFILES_DIRECTORY="/var/samba/profiles"
SAMBA3_PASSDB_DIRECTORY="/usr/pkg/etc/samba/private"
SAMBA3_PASSDB_BACKEND="tdbsam"
SAMBA3_INIT_SCRIPTS="nmbd smbd"
SAMBA3_INIT_CONFIG=""
SAMBA3_INIT_STRING=""

# Used by Services/http/apache2
APACHE2_PACKAGES_REQUIRED="1"
APACHE2_PACKAGES_LISTING="www/apache22"
APACHE2_SERVICE_DEPS=""
APACHE2_CONFIG_DIRECTORY="/usr/pkg/etc/httpd"
APACHE2_DATA_DIRECTORY="/var/www/htdocs"
APACHE2_LOGGING_DIRECTORY="/var/log/httpd"
APACHE2_ICONS_DIRECTORY="/usr/pkg/share/httpd/icons"
APACHE2_CGIBIN_DIRECTORY="/var/www/cgi-bin"
APACHE2_SITES_DIRECTORY="/var/www/sites"
APACHE2_STATE_DIRECTORY="/var/run"
APACHE2_MODULES_DIRECTORY="/usr/pkg/lib/httpd"
APACHE2_MODULAR_BACKEND="0"
APACHE2_DAEMON_USER="www"
APACHE2_DAEMON_GROUP="www"
APACHE2_INIT_SCRIPTS="apache"
APACHE2_INIT_CONFIG=""
APACHE2_INIT_STRING=""

# Used by Services/vcs/subversion1
SUBVERSION1_PACKAGES_REQUIRED="1"
SUBVERSION1_PACKAGES_LISTING="devel/subversion-base www/ap2-subversion"
SUBVERSION1_SERVICE_DEPS="http(apache2)"
SUBVERSION1_CONFIG_DIRECTORY="/usr/pkg/etc"
SUBVERSION1_DATA_DIRECTORY="/var/subversion"
SUBVERSION1_INIT_SCRIPTS=""
SUBVERSION1_INIT_CONFIG=""
SUBVERSION1_INIT_STRING=""

# Used by Services/its/trac0
TRAC0_PACKAGES_REQUIRED="1"
TRAC0_PACKAGES_LISTING="www/ap2-wsgi www/trac"
TRAC0_SERVICE_DEPS="http(apache2) vcs(subversion1)"
TRAC0_CONFIG_DIRECTORY="/usr/pkg/etc"
TRAC0_DATA_DIRECTORY="/var/trac"
TRAC0_HOME_DIRECTORY="/usr/pkg/lib/python2.4/site-packages/trac"
TRAC0_APACHE2_MODULE="wsgi"
TRAC0_INIT_SCRIPTS=""
TRAC0_INIT_CONFIG=""
TRAC0_INIT_STRING=""

# Used by Services/cms/cfengine2
CFENGINE2_PACKAGES_REQUIRED="1"
CFENGINE2_PACKAGES_LISTING="sysutils/cfengine2"
CFENGINE2_SERVICE_DEPS=""
CFENGINE2_CONFIG_DIRECTORY="/usr/pkg/etc/cfengine"
CFENGINE2_DATA_DIRECTORY="/var/cfengine"
CFENGINE2_BINARY_DIRECTORY="/usr/pkg/sbin"
CFENGINE2_INIT_SCRIPTS="cfservd"
CFENGINE2_INIT_CONFIG=""
CFENGINE2_INIT_STRING=""
