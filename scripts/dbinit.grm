import com.tinkerpop.blueprints.Edge
import com.tinkerpop.blueprints.Vertex
import org.openpcf.universal.graph.UniversalGraphFactory

println " * creating or opening target/test-titandb"
g = UniversalGraphFactory.create("target/test-titandb")

try {
    println " * checking if a generic operating system exists.."
    testresult = testresult = g.V("name", "genericUnixLikeOperatingSystem").next()
}
catch (Exception e) {
    println " * guess not. loading default data into graph.."

    // Allowed keys.
    final String INDEX_NAME = "search"

    g.makeKey("type").dataType(String.class).indexed(Vertex.class).make()
    g.makeKey("name").dataType(String.class).indexed(Vertex.class).unique().make()
    g.makeKey("desc").dataType(String.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("icon").dataType(String.class).make()

    g.makeKey("deviceModel").dataType(String.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("deviceRevision").dataType(String.class).indexed(INDEX_NAME, Vertex.class).make()

    g.makeKey("softwareVersion").dataType(String.class).indexed(INDEX_NAME, Vertex.class).make()

    g.makeKey("macAddr").dataType(String.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("netIpv4Addr").dataType(String.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("netIpv4Port").dataType(Integer.class).indexed(INDEX_NAME, Vertex.class).make()

    g.makeKey("storageSize").dataType(Integer.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("cacheSize").dataType(Integer.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("memSize").dataType(Integer.class).indexed(INDEX_NAME, Vertex.class).make()

    g.makeKey("cpuCores").dataType(Integer.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("gpuCores").dataType(Integer.class).indexed(INDEX_NAME, Vertex.class).make()

    g.makeKey("cpuSpeed").dataType(Integer.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("gpuSpeed").dataType(Integer.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("memSpeed").dataType(Integer.class).indexed(INDEX_NAME, Vertex.class).make()

    g.makeKey("baudRate").dataType(Integer.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("dataBits").dataType(Integer.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("parity").dataType(String.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("stopBits").dataType(Integer.class).indexed(INDEX_NAME, Vertex.class).make()

    g.makeKey("execPath").dataType(String.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("execImage").dataType(String.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("execArgs").dataType(String.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("execLang").dataType(String.class).indexed(INDEX_NAME, Vertex.class).make()

    g.makeKey("vmHome").dataType(String.class).make()
    g.makeKey("vmData").dataType(String.class).make()

    g.makeKey("cmdContent").dataType(String.class).make()
    g.makeKey("cmdStarted").dataType(Date.class).indexed(Vertex.class).make()
    g.makeKey("cmdFinished").dataType(Date.class).indexed(Vertex.class).make()
    g.makeKey("cmdResult").dataType(String.class).indexed(INDEX_NAME, Vertex.class).make()
    g.makeKey("cmdExit").dataType(Integer.class).make()

    g.makeLabel("vendor").manyToOne().make()
    g.makeLabel("uses").manyToMany().make()
    g.makeLabel("isa").oneToOne().make()
    g.makeLabel("has").manyToMany().make()

    g.commit()
    println " * finished setting key definitions and constraints"

    // Generic vendor.
    Vertex genericVendor = g.addVertex(null)
    genericVendor.setProperty("type", "Vendor")
    genericVendor.setProperty("name", "genericVendor")
    genericVendor.setProperty("desc", "A generic devices and software vendor.")
    genericVendor.setProperty("icon", "icons/genericVendor.svg")

    // Generic network device.
    Vertex genericNetworkDevice = g.addVertex(null)
    genericNetworkDevice.setProperty("type", "NetworkDevice")
    genericNetworkDevice.setProperty("name", "genericNetworkDevice")
    genericNetworkDevice.setProperty("desc", "A generic network device.")
    genericNetworkDevice.setProperty("icon", "icons/genericNetworkDevice.svg")

    genericNetworkDevice.setProperty("deviceModel", "Generic Network Device")
    genericNetworkDevice.setProperty("deviceRevision", "REV1")

    genericNetworkDevice.setProperty("macAddr", "00:00:00:00:00:00")

    genericNetworkDevice.addEdge("vendor", genericVendor)

    // Default SSH listener.
    Vertex defaultSshListener = g.addVertex(null)
    defaultSshListener.setProperty("netIpv4Addr", "0.0.0.0")
    defaultSshListener.setProperty("netIpv4Port", 22)

    // Default SMB listener.
    Vertex defaultSmbListener = g.addVertex(null)
    defaultSmbListener.setProperty("netIpv4Addr", "0.0.0.0")
    defaultSmbListener.setProperty("netIpv4Port", 445)

    // Default RDP listener.
    Vertex defaultRdpListener = g.addVertex(null)
    defaultRdpListener.setProperty("netIpv4Addr", "0.0.0.0")
    defaultRdpListener.setProperty("netIpv4Port", 3389)

    // Generic SSH service.
    Vertex genericSshService = g.addVertex(null)
    genericSshService.setProperty("type", "TextualAccessor")
    genericSshService.setProperty("name", "genericSshService")
    genericSshService.setProperty("desc", "A generic SSH service.")
    genericSshService.setProperty("icon", "icons/genericSshService.svg")

    genericSshService.setProperty("softwareVersion", "1")

    genericSshService.setProperty("execPath", "/usr/sbin")
    genericSshService.setProperty("execImage", "sshd")

    genericSshService.addEdge("vendor", genericVendor)
    genericSshService.addEdge("has", defaultSshListener)

    // Generic SMB service.
    Vertex genericSmbService = g.addVertex(null)
    genericSmbService.setProperty("type", "TextualAccessor")
    genericSmbService.setProperty("name", "genericSmbService")
    genericSmbService.setProperty("desc", "A generic SMB service.")
    genericSmbService.setProperty("icon", "icons/genericSmbService.svg")

    genericSmbService.setProperty("softwareVersion", "1")

    genericSmbService.setProperty("execPath", "C:/Windows/System32")
    genericSmbService.setProperty("execImage", "svchost.exe")
    genericSmbService.setProperty("execArgs", "-k netsvcs")

    genericSmbService.addEdge("vendor", genericVendor)
    genericSmbService.addEdge("has", defaultSmbListener)

    // Generic RDP service.
    Vertex genericRdpService = g.addVertex(null)
    genericRdpService.setProperty("type", "GraphicalAccessor")
    genericRdpService.setProperty("name", "genericRdpService")
    genericRdpService.setProperty("desc", "A generic RDP service.")
    genericRdpService.setProperty("icon", "icons/genericRdpService.svg")

    genericRdpService.setProperty("softwareVersion", "1")

    genericRdpService.setProperty("execPath", "C:/Windows/System32")
    genericRdpService.setProperty("execImage", "svchost.exe")
    genericRdpService.setProperty("execArgs", "-k termsvcs")

    genericRdpService.addEdge("vendor", genericVendor)
    genericRdpService.addEdge("has", defaultRdpListener)

    // Generic DOS interpreter.
    Vertex genericDosInterpreter = g.addVertex(null)
    genericDosInterpreter.setProperty("type", "Interpreter")
    genericDosInterpreter.setProperty("name", "genericDosInterpreter")
    genericDosInterpreter.setProperty("desc", "A generic DOS command-line interpreter.")
    genericDosInterpreter.setProperty("icon", "icons/genericDosInterpreter.svg")

    genericDosInterpreter.setProperty("softwareVersion", "1")

    genericDosInterpreter.setProperty("execPath", "C:/Windows/System32")
    genericDosInterpreter.setProperty("execImage", "cmd.exe")
    genericDosInterpreter.setProperty("execLang", "DOS")

    genericDosInterpreter.addEdge("vendor", genericVendor)
    genericDosInterpreter.addEdge("uses", genericSmbService)

    // Generic (Bourne/Posix/UNIX) Shell interpreter.
    Vertex genericShellInterpreter = g.addVertex(null)
    genericShellInterpreter.setProperty("type", "Interpreter")
    genericShellInterpreter.setProperty("name", "genericShellInterpreter")
    genericShellInterpreter.setProperty("desc", "A generic (Bourne/Posix/UNIX) Shell command-line interpreter.")
    genericShellInterpreter.setProperty("icon", "icons/genericShellInterpreter.svg")

    genericShellInterpreter.setProperty("softwareVersion", "1")

    genericDosInterpreter.setProperty("execPath", "/bin")
    genericDosInterpreter.setProperty("execImage", "sh")
    genericDosInterpreter.setProperty("execLang", "SH")

    genericShellInterpreter.addEdge("vendor", genericVendor)
    genericShellInterpreter.addEdge("uses", genericSshService)

    // Generic storage device.
    Vertex genericStorageDevice = g.addVertex(null)
    genericStorageDevice.setProperty("type", "StorageDevice")
    genericStorageDevice.setProperty("name", "genericStorageDevice")
    genericStorageDevice.setProperty("desc", "A generic storage device.")
    genericStorageDevice.setProperty("icon", "icons/genericStorageDevice.svg")

    genericStorageDevice.setProperty("deviceModel", "Generic Storage Device")
    genericStorageDevice.setProperty("deviceRevision", "REV1")

    genericStorageDevice.setProperty("storageSize", 1048576)

    genericStorageDevice.addEdge("vendor", genericVendor)

    // Generic memory module.
    Vertex genericMemoryModule = g.addVertex(null)
    genericMemoryModule.setProperty("type", "MemoryModule")
    genericMemoryModule.setProperty("name", "genericMemoryModule")
    genericMemoryModule.setProperty("desc", "A generic memory module.")
    genericMemoryModule.setProperty("icon", "icons/genericMemoryModule.svg")

    genericMemoryModule.setProperty("deviceModel", "Generic Memory Module")
    genericMemoryModule.setProperty("deviceRevision", "REV1")

    genericMemoryModule.setProperty("memSize", 1048576)
    genericMemoryModule.setProperty("memSpeed", 1000000)

    genericMemoryModule.addEdge("vendor", genericVendor)

    // Generic processing unit.
    Vertex genericProcessingUnit = g.addVertex(null)
    genericProcessingUnit.setProperty("type", "ProcessingUnit")
    genericProcessingUnit.setProperty("name", "genericProcessingUnit")
    genericProcessingUnit.setProperty("desc", "A generic processing unit.")
    genericProcessingUnit.setProperty("icon", "icons/genericProcessingUnit.svg")

    genericProcessingUnit.setProperty("deviceModel", "Generic processing unit.")
    genericProcessingUnit.setProperty("deviceRevision", "REV1")

    genericProcessingUnit.setProperty("cpuCores", 1)
    genericProcessingUnit.setProperty("cpuSpeed", 10000000)
    genericProcessingUnit.setProperty("cacheSize", 1024)

    genericProcessingUnit.addEdge("vendor", genericVendor)

    // Generic graphics device.
    Vertex genericGraphicsDevice = g.addVertex(null)
    genericGraphicsDevice.setProperty("type", "GraphicsDevice")
    genericGraphicsDevice.setProperty("name", "genericGraphicsDevice")
    genericGraphicsDevice.setProperty("desc", "A generic graphics device.")
    genericGraphicsDevice.setProperty("icon", "icons/genericGraphicsDevice.svg")

    genericGraphicsDevice.setProperty("deviceModel", "Generic graphics device.")
    genericGraphicsDevice.setProperty("deviceRevision", "REV1")

    genericGraphicsDevice.setProperty("gpuCores", 1)
    genericGraphicsDevice.setProperty("gpuSpeed", 1000000)
    genericGraphicsDevice.setProperty("memSize", 33554432)

    genericGraphicsDevice.addEdge("vendor", genericVendor)

    // Generic console device.
    Vertex genericConsoleDevice = g.addVertex(null)
    genericConsoleDevice.setProperty("type", "GraphicsDevice")
    genericConsoleDevice.setProperty("name", "genericConsoleDevice")
    genericConsoleDevice.setProperty("desc", "A generic console device.")
    genericConsoleDevice.setProperty("icon", "icons/genericConsoleDevice.svg")

    genericConsoleDevice.setProperty("deviceModel", "Generic console device.")
    genericConsoleDevice.setProperty("deviceRevision", "REV1")

    genericConsoleDevice.setProperty("baudRate", 9600)
    genericConsoleDevice.setProperty("dataBits", 8)
    genericConsoleDevice.setProperty("parity", "N")
    genericConsoleDevice.setProperty("stopBits", 1)

    genericConsoleDevice.addEdge("vendor", genericVendor)

    // Generic UNIX-like operating system.
    Vertex genericUnixLikeOperatingSystem = g.addVertex(null)
    genericUnixLikeOperatingSystem.setProperty("type", "OperatingSystem")
    genericUnixLikeOperatingSystem.setProperty("name", "genericUnixLikeOperatingSystem")
    genericUnixLikeOperatingSystem.setProperty("desc", "A generic UNIX-like operating system.")
    genericUnixLikeOperatingSystem.setProperty("icon", "icons/genericUnixLikeOperatingSystem.svg")

    genericUnixLikeOperatingSystem.addEdge("vendor", genericVendor)
    genericUnixLikeOperatingSystem.addEdge("has", genericSshService)
    genericUnixLikeOperatingSystem.addEdge("has", genericShellInterpreter)

    // Generic Windows-like operating system.
    Vertex genericWindowsLikeOperatingSystem = g.addVertex(null)
    genericWindowsLikeOperatingSystem.setProperty("type", "OperatingSystem")
    genericWindowsLikeOperatingSystem.setProperty("name", "genericWindowsLikeOperatingSystem")
    genericWindowsLikeOperatingSystem.setProperty("desc", "A generic Windows-like operating system.")
    genericWindowsLikeOperatingSystem.setProperty("icon", "icons/genericWindowsLikeOperatingSystem.svg")

    genericWindowsLikeOperatingSystem.addEdge("vendor", genericVendor)
    genericWindowsLikeOperatingSystem.addEdge("has", genericSmbService)
    genericWindowsLikeOperatingSystem.addEdge("has", genericRdpService)
    genericWindowsLikeOperatingSystem.addEdge("has", genericDosInterpreter)


    g.commit()

    testresult = g.V("name", "genericUnixLikeOperatingSystem").next()
}

println " * did we find a generic operating system: " + testresult.getProperty("name")
