{
  "name": "OsDiscover",
  "desc": "Scan an IP address with ansible for setup information.",
  "meta": {
    "uuid": "725f14be-6c77-4d9a-a946-03c7a066e833",
    "relations": {
      "PROVIDED_BY": {
        "direction": "outgoing",
        "to": ["Ansible"]
      },
      "APPLIES_TO": {
        "direction": "outgoing",
        "to": ["Ipv4Address"]
      },
      "GIVES_CAPABILITY": {
        "direction": "outgoing",
        "to": ["Detect"]
      },
      "INSTANCE_OF": {
        "direction": "outgoing",
        "to": ["Controller"]
      }
    }
  },
  "data": {
    "instrumentType": "controller",
    "timeAllocated": 60000,
    "subjectIsLocal": false,
    "weight": 10,
    "arguments": {
      "selfId": {
        "value": { "from": "static", "type": "string", "strategy": "mustBeOne" },
        "canBeUserSupplied": false,
        "isOptional": false
      },
      "ipaddress": {
        "value": {
          "from": "origin",
          "type": "type.component.configuration.ipaddress.ipv4address",
          "strategy": "useFirst",
          "onError": "fail"
        },
        "canBeUserSupplied": false,
        "isOptional": false
      }
    }
  },
  "file": {
    "dataSchema": {
      "encoding": "text",
      "format": "json",
      "path": "../../core/schema/controller.schema.json"
    },
    "templateFile": {
      "encoding": "text",
      "format": "hbs",
      "path": "osdiscovery.hbs.sh"
    }
  }
}
