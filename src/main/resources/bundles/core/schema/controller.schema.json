{
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "name": {
      "$ref": "type.schema.json#/properties/name"
    },
    "desc": {
      "$ref": "type.schema.json#/properties/desc"
    },
    "weight": {
      "$ref": "instrument.schema.json#/properties/weight"
    },
    "instrumentType": {
      "$ref": "instrument.schema.json#/properties/instrumentType"
    },
    "subjectIsLocal": {
      "$ref": "instrument.schema.json#/properties/subjectIsLocal"
    },
    "interpreter": {
      "type": "string"
    },
    "resultParser": {
      "type": "string",
      "description": "The parser able to convert the raw results of this instrument."
    },
    "timeAllocated": {
      "type": "integer",
      "minimum": 0,
      "description": "The amount of time (in ms) allocated for the execution of this controller.",
      "default": 3000
    },
    "extension": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9]+$",
      "description": "Possible extension in case of a scriptable instrument."
    },
    "stateMap": {
      "type": "object",
      "patternProperties": {
        "^([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$": {
          "$ref": "#/definitions/state"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "arguments": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9]+$": {
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "canBeUserSupplied": {
              "type": "boolean",
              "default": false
            },
            "isOptional": {
              "type": "boolean",
              "default": false
            },
            "pass": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "option": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              },
              "oneOf": [
                {
                  "required": ["option"]
                },
                {
                  "required": ["index"]
                }
              ]
            },
            "value": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "enum": ["subject", "origin", "agent", "static"]
                },
                "type": {
                  "type": "string",
                  "pattern": "^(\\w+(\\.\\w+)+|string)$"
                },
                "matches": {
                  "type": ["object", "string"]
                },
                "defaultValue": {
                  "type": "string"
                },
                "strategy": {
                  "type": "string",
                  "enum": ["useFirst", "useLast", "mustBeOne", "mustBeMany"],
                  "default": "mustBeOne"
                },
                "onError": {
                  "type": "string",
                  "enum": ["fail", "askUser", "ignore"],
                  "default": "fail"
                }
              },
              "required": ["from", "type"]
            }
          }
        }
      }
    }
  },
  "required": ["name", "desc", "instrumentType", "subjectIsLocal"],
  "definitions": {
    "state": {
      "type": "object",
      "required": ["code", "interpretation", "description"],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "description": "A code representing the \"goodness\" of the result, 0 being \"good\", 2 being \"bad\"."
        },
        "interpretation": {
          "type": "string",
          "description": "A short word conveying the meaning of \"stateCode\", e.g. \"OK\", \"MAYBE\", \"NOK\""
        },
        "description": {
          "type": "string",
          "description": "A longer description of the reason for the status code."
        }
      }
    }
  }
}
