{
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Schema for Structure instruments.",
  "required": ["name", "desc", "instrumentType", "subjectIsLocal"],
  "type": "object",
  "properties": {
    "name": {
      "$ref": "type.schema.json#/properties/name"
    },
    "desc": {
      "$ref": "type.schema.json#/properties/desc"
    },
    "weight": {
      "type": "number",
      "description": "The weight of a instrument, used choose between instruments."
    },
    "instrumentType": {
      "type": "string",
      "enum": ["controller", "marker", "parser"]
    },
    "subjectIsLocal": {
      "type": "boolean",
      "description": "Is the subject for this instrument local or remote?"
    }
  }
}
