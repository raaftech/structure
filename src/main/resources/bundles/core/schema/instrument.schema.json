{
  "additionalProperties": false,
  "$schema": "http://json-schema.org/schema#",
  "description": "Schema for Structure instruments.",
  "required": [
    "name",
    "desc",
    "instrumentType",
    "subjectIsLocal"
  ],
  "type": "object",
  "properties": {
    "name": {
      "$ref": "type.schema.json#/properties/name"
    },
    "weight": {
      "type": "number",
      "description": "The weight of a instrument, used choose between instruments."
    },
    "desc": {
      "$ref": "type.schema.json#/properties/desc"
    },
    "filePath": {
      "type": "string",
      "description": "The filesystem location of the instrument."
    },
    "instrumentType": {
      "type": "string",
      "pattern": "^controller|marker|parser$"
    },
    "interpreter": {
      "type": "string"
    },
    "subjectIsLocal": {
      "type": "boolean"
    },
    "extension": {
      "type": "string",
      "pattern": "^\\.[A-Za-z0-9]+$"
    },
    "arguments": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9]+$": {
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "canBeUserSupplied": {
              "type": "boolean",
              "default": "false"
            },
            "isOptional": {
              "type": "boolean",
              "default": "false"
            },
            "pass": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "index": {
                  "type": "number"
                },
                "option": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              },
              "oneOf": [
                {
                  "required": [
                    "option"
                  ]
                },
                {
                  "required": [
                    "index"
                  ]
                }
              ]
            },
            "value": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^subject|origin|agent|static$"
                },
                "type": {
                  "type": "string",
                  "pattern": "^\\w+(\\.\\w+)+|string$"
                },
                "matches": {
                  "type": [
                    "object",
                    "string"
                  ]
                },
                "defaultValue": {
                  "type": "string"
                },
                "strategy": {
                  "type": "string",
                  "pattern": "^useFirst|useLast|mustBeOne|mustBeMany$",
                  "default": "mustBeOne"
                },
                "onError": {
                  "type": "string",
                  "pattern": "^fail|askUser|ignore$",
                  "default": "fail"
                }
              },
              "required": [
                "from",
                "type"
              ]
            }
          }
        }
      }
    }
  }
}
