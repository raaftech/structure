{
  "additionalProperties": false,
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "name": {
      "$ref": "type.schema.json#/properties/name"
    },
    "weight": {
      "type": "number",
      "description": "The weight of a instrument, used choose between instruments."
    },
    "desc": {
      "$ref": "type.schema.json#/properties/desc"
    },
    "filePath": {
      "type": "string",
      "description": "The filesystem location of the instrument."
    }
