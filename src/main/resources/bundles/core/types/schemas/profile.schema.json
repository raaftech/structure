{
	"additionalProperties": false,
	"$schema": "http://json-schema.org/schema#",
	"type": "object",
	"required": [
		"name",
		"desc",
		"appliesTo",
		"providedBy"
	],
	"properties": {
		"name": {
			"$ref": "type.schema.json#/properties/name"
		},
		"checksum": {
			"$ref": "type.schema.json#/properties/checksum"
		},
		"desc": {
			"$ref": "type.schema.json#/properties/desc"
		},
		"providedBy": {
			"$ref": "#/definitions/caseInsensitiveAlphaNum"
		},
		"appliesTo": {
			"$ref": "#/definitions/caseInsensitiveAlphaNum"
		},
		"packageNames": {
			"$ref": "#/definitions/stringOrStringArray"
		},
		"serviceNames": {
			"$ref": "#/definitions/stringOrStringArray"
		},
		"commands": {
			"type": "object",
			"patternProperties": {
				"^[a-zA-Z0-9]+$": {
					"required": [
						"command",
						"matches"
					],
					"additionalProperties": false,
					"properties": {
						"command": {
							"$ref": "#/definitions/stringOrStringArray"
						},
						"matches": {
							"$ref": "#/definitions/stringOrStringArray"
						}
					}
				}
			}
		},
		"directories": {
			"type": "object",
			"anyOf": [
				{
					"required": [
						"logDirectories"
					]
				},
				{
					"required": [
						"dataDirectories"
					]
				},
				{
					"required": [
						"binaryDirectories"
					]
				},
				{
					"required": [
						"libraryDirectories"
					]
				},
				{
					"required": [
						"configurationDirectories"
					]
				}
			],
			"additionalProperties": false,
			"properties": {
				"logDirectories": {
					"$ref": "#/definitions/paths"
				},
				"dataDirectories": {
					"$ref": "#/definitions/paths"
				},
				"binaryDirectories": {
					"$ref": "#/definitions/paths"
				},
				"libraryDirectories": {
					"$ref": "#/definitions/paths"
				},
				"configurationDirectories": {
					"$ref": "#/definitions/paths"
				}
			}
		},
		"files": {
			"type": "object",
			"anyOf": [
				{
					"required": [
						"logFiles"
					]
				},
				{
					"required": [
						"dataFiles"
					]
				},
				{
					"required": [
						"binaryFiles"
					]
				},
				{
					"required": [
						"libraryFiles"
					]
				},
				{
					"required": [
						"configurationFiles"
					]
				}
			],
			"additionalProperties": false,
			"properties": {
				"logFiles": {
					"$ref": "#/definitions/paths"
				},
				"dataFiles": {
					"$ref": "#/definitions/paths"
				},
				"binaryFiles": {
					"$ref": "#/definitions/paths"
				},
				"libraryFiles": {
					"$ref": "#/definitions/paths"
				},
				"configurationFiles": {
					"$ref": "#/definitions/paths"
				}
			}
		}
	},
	"definitions": {
		"caseInsensitiveAlphaNum": {
			"type": "string",
			"pattern": "^[a-zA-Z0-9]+$"
		},
		"paths": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string"
			}
		},
		"stringOrStringArray": {
			"type": [
				"string",
				"array"
			],
			"minItems": 1,
			"items": {
				"type": "string"
			}
		}
	}
}
