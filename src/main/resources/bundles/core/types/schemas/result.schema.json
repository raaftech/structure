{
  "additionalProperties": false,
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "user": {
      "type": "string",
      "description": "The user that invoked the action leading to this result."
    },
    "returnCode": {
      "type": "number",
      "description": "The returncode of a process"
    },
    "process": {
      "type": "string",
      "description": "Process that resulted in this result."
    },
    "task": {
      "type": "string",
      "description": "The task ID."
    },
    "dateCreated": {
      "type": "number",
      "description": "The date + time when the result was created."
    },
    "stdout": {
      "type": "string",
      "description": "The stdout of a program."
    },
    "name": {
      "$ref": "type.schema.json#/properties/name"
    },
    "checksum": {
      "$ref": "type.schema.json#/properties/checksum"
    },
    "stderr": {
      "type": "string",
      "description": "The stdout of a program."
    },
    "error": {
      "type": "string",
      "description": "A field describing why the action resulted in an error. This implies the process couldn't run."
    },
    "desc": {
      "$ref": "type.schema.json#/properties/desc"
    },
    "stateCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "stateInterpretation": {
      "type": "string"
    },
    "stateDescription": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "desc",
    "task",
    "process",
    "dateCreated"
  ]
}