{
  "additionalProperties": false,
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "user": {
      "type": "string",
      "description": "The user that invoked the action leading to this result."
    },
    "returnCode": {
      "type": "number",
      "description": "The returncode of a process"
    },
    "process": {
      "type": "string",
      "description": "Process that resulted in this result."
    },
    "task": {
      "type": "string",
      "description": "The task ID."
    },
    "dateCreated": {
      "type": "number",
      "description": "The date + time when the result was created."
    },
    "stdout": {
      "type": "string",
      "description": "The stdout of a program."
    },
    "name": {
      "$ref": "type.schema.json#/properties/name"
    },
    "checksum": {
      "$ref": "type.schema.json#/properties/checksum"
    },
    "stderr": {
      "type": "string",
      "description": "The stdout of a program."
    },
    "desc": {
      "$ref": "type.schema.json#/properties/desc"
    },
    "state": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "desc",
    "task",
    "process",
    "returnCode",
    "stdout",
    "stderr",
    "dateCreated"
  ],
  "definitions": {
    "state": {
      "type": "object",
      "required": [ "code", "interpretation", "description" ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "description": "A code representing the \"goodness\" of the result, 0 being \"good\", 2 being \"bad\"."
        },
        "interpretation": {
          "type": "string",
          "description": "A short word conveying the meaning of \"stateCode\", e.g. \"OK\", \"MAYBE\", \"NOK\""
        },
        "description": {
          "type": "string",
          "description": "A longer description of the reason for the status code."
        }
      }
    }
  }
}