{
  "name": "NmapVerify",
  "desc": "Verify that an IP address is up, with nmap.",
  "meta": {
    "uuid": "59ddead8-1a43-41c8-899f-008f56adabcb",
    "relations": {
      "PROVIDED_BY": {
        "direction": "outgoing",
        "to": ["Nmap"]
      },
      "APPLIES_TO": {
        "direction": "outgoing",
        "to": ["Ipv4Address"]
      },
      "GIVES_CAPABILITY": {
        "direction": "outgoing",
        "to": ["Verify"]
      },
      "INSTANCE_OF": {
        "direction": "outgoing",
        "to": ["Controller"]
      }
    }
  },
  "data": {
    "instrumentType": "controller",
    "subjectIsLocal": false,
    "timeAllocated": 10000,
    "stateMap": {
      "0": {
        "code": 0,
        "interpretation": "OK",
        "description": "The address is up."
      },
      "1": {
        "code": 2,
        "interpretation": "NOK",
        "description": "The address is down."
      },
      "2": {
        "code": 2,
        "interpretation": "NOK",
        "description": "Some other error occurred, see STDOUT or STDERR."
      }
    },
    "arguments": {
      "ipv4address": {
        "value": {
          "from": "origin",
          "type": "type.component.configuration.ipaddress.ipv4address",
          "strategy": "useFirst",
          "onError": "fail"
        },
        "canBeUserSupplied": false,
        "isOptional": false
      }
    }
  },
  "file": {
    "dataSchema": {
      "encoding": "text",
      "format": "json",
      "path": "../core/schema/controller.schema.json"
    },
    "templateFile": {
      "encoding": "text",
      "format": "hbs",
      "path": "nmapverify.hbs.sh"
    }
  }
}
