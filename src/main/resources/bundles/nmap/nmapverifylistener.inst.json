      "APPLIES_TO": {
        "direction": "outgoing",
        "to": ["Ipv4Listener"]
      },
      "GIVES_CAPABILITY": {
        "direction": "outgoing",
        "to": ["Verify"]
      },
      "INSTANCE_OF": {
        "direction": "outgoing",
        "to": ["Controller"]
      }
    }
  },
