{
  "name": "SmbClientSendFile",
  "desc": "The handler that provides the SendFile capability to smbclient.",
  "meta": {
    "uuid": "320aa7ee-da10-46d6-9ed4-34cd8d43f088",
    "relations": {
      "PROVIDED_BY": {
        "direction": "outgoing",
        "to": ["SambaClient"]
      },
      "APPLIES_TO": {
        "direction": "outgoing",
        "to": ["SambaClient"]
      },
      "GIVES_CAPABILITY": {
        "direction": "outgoing",
        "to": ["SendFile"]
      },
      "INSTANCE_OF": {
        "direction": "outgoing",
        "to": ["Controller"]
      }
    }
  },
  "data": {
    "instrumentType": "controller",
    "subjectIsLocal": false,
    "weight": 90,
    "arguments": {
      "ipv4address": {
        "value": {
          "from": "subject",
          "type": "type.component.configuration.ipaddress.ipv4address",
          "matches": {
            "reachable": "true"
          },
          "strategy": "useFirst",
          "onError": "fail"
        },
        "canBeUserSupplied": false,
        "isOptional": false
      },
      "payloadDirectory": {
        "value": {
          "from": "static",
          "type": "string",
          "strategy": "mustBeOne"
        },
        "canBeUserSupplied": false,
        "isOptional": false
      },
      "payloadFileName": {
        "value": {
          "from": "static",
          "type": "string",
          "strategy": "mustBeOne"
        },
        "canBeUserSupplied": false,
        "isOptional": false
      },
      "username": {
        "value": {
          "from": "static",
          "type": "string",
          "defaultValue": "Administrator",
          "strategy": "mustBeOne"
        },
        "canBeUserSupplied": true,
        "isOptional": true
      },
      "password": {
        "value": {
          "from": "static",
          "type": "string",
          "strategy": "mustBeOne"
        },
        "canBeUserSupplied": true,
        "isOptional": false
      }
    }
  },
  "file": {
    "dataSchema": {
      "encoding": "text",
      "format": "json",
      "path": "../../core/schema/controller.schema.json"
    },
    "templateFile": {
      "encoding": "text",
      "format": "hbs",
      "path": "smbsendfile.hbs.sh"
    }
  }
}
