{
  "additionalProperties": false,
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "name": {
      "$ref": "type.schema.json#/properties/name"
    },
    "addr": {
      "type": "string",
      "description": "IP listeners should at least have the addr and port fields."
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "IP listeners should at least have the addr and port fields."
    },
    "desc": {
      "$ref": "type.schema.json#/properties/desc"
    }
  },
  "required": ["name", "desc", "addr", "port"]
}
