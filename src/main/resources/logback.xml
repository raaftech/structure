<?xml version="1.0" encoding="UTF-8"?>

<configuration>

	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<!-- encoders are assigned ch.qos.logback.classic.encoder.PatternLayoutEncoder 
			by default -->
		<encoder>
            <!-- <pattern>[%-5level] %logger{5}: %msg%n</pattern> - much nicer, but vertx logs like below-->
			<pattern>%level: %msg%n</pattern>
		</encoder>
	</appender>

	<root level="INFO">
		<appender-ref ref="STDOUT" />
	</root>

</configuration>