<?xml version="1.0" encoding="UTF-8" ?>
<configuration>
  <!-- Logback finds HOSTNAME itself; it is fine -->
  <contextName>${HOSTNAME}</contextName>
  <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
    <resetJUL>true</resetJUL>
  </contextListener>

  <!-- Disables logback status message at start of application -->
  <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.out</target>
    <encoder>
      <pattern>[%level] [%date{"yyyy-MM-dd'T'HH:mm:ss,SSSXXX", UTC}] [%contextName] %c{0}: %m%n</pattern>
    </encoder>
  </appender>

  <root level="WARN">
    <appender-ref ref="STDOUT" />
  </root>

  <logger name="ch.qos" level="WARN" />
  <logger name="io.netty" level="WARN" />
  <!-- <logger name="io.vertx" level="WARN"/> -->
  <logger name="org.eclipse" level="WARN" />
  <logger name="org.eclipse.jetty.server" level="ERROR" />
  <logger name="sun.rmi" level="WARN" />
</configuration>
