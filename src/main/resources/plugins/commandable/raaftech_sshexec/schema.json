{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "description": "Schema for raaftech_sshexec plugin.",
    "type":"object",
    "additionalProperties": false,
    "properties": {
        "node": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "task": {
            "type": "string"
        },
        "command": {
            "type": "string"
        },
        "address": {
            "type": "string"
        }
    },
    "required": [ "node", "task", "command", "address" ]
}