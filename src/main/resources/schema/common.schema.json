{
  "id": "#",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Common Definitions",
  "description": "Common definitions used in multiple schemas.",
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "stringpattern": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9]+$"
    }
  }
}
