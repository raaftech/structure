{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Common definitions used in multiple schemas.",
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "uuidList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/uuid"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "caseInsensitiveAlphaNum": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9]+$"
    },
    "caseInsensitiveAlphaNumWithDot": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9\\.]+$"
    },
    "uuidOrName": {
      "anyOf": [
        {
          "$ref": "#/definitions/uuid"
        },
        {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]+$"
        }
      ]
    },
    "uuidOrNameArray": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/uuidOrName"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "stringOrStringArray": {
      "type": ["string", "array"],
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
