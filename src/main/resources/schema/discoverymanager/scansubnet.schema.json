{
    "id": "https://repo.raaftech.com/schema/discoverymanager/scansubet.json#",
    "$schema": "http://json-schema.org/draft-04/schema#",
    "description": "Schema for the scansubnet method in DiscoveryManager.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "subnet": {
            "type": "string",
            "pattern": "^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])(\\/([0-9]|[1-2][0-9]|3[0-2]))$"
        }
    },
    "required": [ "subnet" ]
}