{
    "id": "https://repo.openpcf.org/schema/framehelper/instantiatetemplate.json#",
    "$schema": "http://json-schema.org/draft-04/schema#",
    "description": "Schema for Structure's FrameHelper instantiatetemplate method.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "template": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "instancedata": {
            "type": "array"
        }
    },
    "required": [ "template", "instancedata" ]
}