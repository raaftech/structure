{
  "id": "https://repo.raaftech.com/schema/handler.schema.json#",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Schema for Structure mustache handler template preambles.",
  "type": "object",
  "required": [ "name", "desc", "capability", "appliesTo", "providedBy", "subjectIsLocal" ],
  "properties": {
    "name": {
      "type": "string"
    },
    "desc": {
      "type": "string"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-zA-Z]*$"
    },
    "providedBy": {
      "type":"string",
      "pattern": "^[a-zA-Z0-9]*$"
    },
    "appliesTo": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9\\.]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "subjectIsLocal": {
      "type": "boolean"
    },
    "weight": {
      "type": "number"
    },
    "extension": {
      "type": "string",
      "pattern": "^\\.[A-Za-z0-9]+$"
    },
    "software": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9\\.]*$"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "arguments": {
      "type": "object",
      "required": [ "non-interactive", "interactive" ],
      "properties": {
        "non-interactive": {
          "type": "object",
          "patternProperties": {
            "^\\w\\.*\\w$": {
              "type": "array"
            }
          }
        },
        "interactive": {
          "type": "object",
          "properties": {
            "required": {
              "type": "array"
            },
            "optional": {
              "type": "array"
            }
          }
        }
      }
    }
  }
}