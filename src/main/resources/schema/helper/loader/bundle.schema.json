{
  "id": "https://repo.raaftech.com/schema/helper/loader/bundle.json#",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "The schema that is used to validate bundle definitions.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "organizationId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "metadata": {
      "type": "object"
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": ["array", "string"]
        },
        "instrument": {
          "type": ["array", "string"]
        },
        "template": {
          "type": ["array", "string"]
        },
        "metadata": {
          "type": ["array", "string"]
        },
        "map": {
          "type": ["array", "string"]
        },
        "artwork": {
          "type": ["array", "string"]
        },
        "documentation": {
          "type": ["array", "string"]
        }
      }
    }
  },
  "required": ["organizationId", "name", "version", "packages"]
}