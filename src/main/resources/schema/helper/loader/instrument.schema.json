{
  "id": "https://repo.raaftech.com/schema/instrument.schema.json#",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Schema for Structure instrument metadata.",
  "type": "object",
  "required": [ "name", "desc", "capability", "instrumentType", "appliesTo", "providedBy", "subjectIsLocal" ],
  "additionalProperties": false,
  "properties": {
    "uuid": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "name": {
      "type": "string"
    },
    "desc": {
      "type": "string"
    },
    "instrumentType": {
      "type": "string",
      "pattern": "^controller|marker|parser$"
    },
    "resultParser": {
      "type": "string"
    },
    "templateFile": {
      "type": "string"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-zA-Z]+$"
    },
    "providedBy": {
      "type":"string",
      "pattern": "^[a-zA-Z0-9]+$"
    },
    "appliesTo": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9\\.]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "subjectIsLocal": {
      "type": "boolean"
    },
    "weight": {
      "type": "number"
    },
    "extension": {
      "type": "string",
      "pattern": "^\\.[A-Za-z0-9]+$"
    },
    "arguments": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9]+$": {
          "properties": {
            "value": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^subject|origin|agent|static$"
                },
                "type": {
                  "type": "string",
                  "pattern": "^\\w+(\\.\\w+)+|string$"
                },
                "matches": {
                  "type": [ "object", "string" ]
                },
                "defaultValue": {
                  "type": "string"
                },
                "strategy": {
                  "type": "string",
                  "pattern": "^useFirst|useLast|mustBeOne|mustBeMany$",
                  "default": "mustBeOne"
                },
                "onError": {
                  "type": "string",
                  "pattern": "^fail|askUser|ignore$",
                  "default": "fail"
                }
              },
              "required": [ "from", "type" ]
            },
            "canBeUserSupplied": {
              "type": "boolean",
              "default": "false"
            },
            "isOptional": {
              "type": "boolean",
              "default": "false"
            }
          },
          "required": [ "value" ]
        }
      },
      "additionalProperties": false
    }
  }
}
