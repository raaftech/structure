{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"description": "Schema for Structure map metadata.",
	"type": "object",
	"required": ["name","desc","appliesTo","providedBy"],
	"additionalProperties": false,
	"properties": {
		"name": {
			"type": "string"
		},
		"desc": {
			"type": "string"
		},
		"providedBy": {
			"$ref": "../../common.schema.json#/definitions/caseInsensitiveAlphaNum"
		},
		"appliesTo": {
			"$ref": "../../common.schema.json#/definitions/caseInsensitiveAlphaNumWithDotArray"
		},
		"packageNames": {
			"$ref": "../../common.schema.json#/definitions/caseInsensitiveAlphaNumWithDotArray"
		},
		"serviceNames": {
			"$ref": "../../common.schema.json#/definitions/caseInsensitiveAlphaNumWithDotArray"
		},
		"commands": {
			"type": "object",
			"patternProperties": {
				"^[a-zA-Z0-9]+$": {
					"required": ["command","matches"],
					"additionalProperties": false,
					"properties": {
						"command": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "string"
							}
						},
						"matches": {
							"type": "string"
						}
					}
				}
			}
		},
		"directories": {
			"type": "object",
			"anyOf": [
			    {"required": ["logDirectories"]},
			    {"required": ["dataDirectories"]},
			    {"required": ["binaryDirectories"]},
			    {"required": ["libraryDirectories"]},
			    {"required": ["configurationDirectories"]}
			],
			"additionalProperties": false,
			"properties": {
				"logDirectories": {
					"$ref": "../../common.schema.json#/definitions/paths"
				},
				"dataDirectories": {
					"$ref": "../../common.schema.json#/definitions/paths"
				},
				"binaryDirectories": {
					"$ref": "../../common.schema.json#/definitions/paths"
				},
				"libraryDirectories": {
					"$ref": "../../common.schema.json#/definitions/paths"
				},
				"configurationDirectories": {
					"$ref": "../../common.schema.json#/definitions/paths"
				}
			}
		},
		"files": {
			"type": "object",
			"anyOf": [
			    {"required": ["logFiles"]},
			    {"required": ["dataFiles"]},
			    {"required": ["binaryFiles"]},
			    {"required": ["libraryFiles"]},
			    {"required": ["configurationFiles"]}
			],
			"additionalProperties": false,
			"properties": {
				"logFiles": {
					"$ref": "../../common.schema.json#/definitions/paths"
				},
				"dataFiles": {
					"$ref": "../../common.schema.json#/definitions/paths"
				},
				"binaryFiles": {
					"$ref": "../../common.schema.json#/definitions/paths"
				},
				"libraryFiles": {
					"$ref": "../../common.schema.json#/definitions/paths"
				},
				"configurationFiles": {
					"$ref": "../../common.schema.json#/definitions/paths"
				}
			}
		}
	}
}