{
	"id": "https://repo.raaftech.com/schema/instrument.schema.json#",
	"$schema": "http://json-schema.org/draft-04/schema#",
	"description": "Schema for Structure map metadata.",
	"type": "object",
	"required": ["name","desc","appliesTo","providedBy"],
	"additionalProperties": false,
	"properties": {
		"name": {
			"type": "string"
		},
		"desc": {
			"type": "string"
		},
		"providedBy": {
			"type": "string",
			"pattern": "^[a-zA-Z0-9]+$"
		},
		"appliesTo": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[a-zA-Z0-9\\.]+$"
			},
			"minItems": 1,
			"uniqueItems": true
		},
		"packageNames": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[a-zA-Z0-9\\.]+$"
			},
			"minItems": 1,
			"uniqueItems": true
		},
		"serviceNames": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[a-zA-Z0-9\\.]+$"
			},
			"minItems": 1,
			"uniqueItems": true
		},
		"commands": {
			"type": "object",
			"patternProperties": {
				"^[a-zA-Z0-9]+$": {
					"required": ["command","matches"],
					"additionalProperties": false,
					"properties": {
						"command": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "string"
							}
						},
						"matches": {
							"type": "string"
						}
					}
				}
			}
		},
		"directories": {
			"type": "object",
			"anyOf": [
			    {"required": ["logDirectories"]},
			    {"required": ["dataDirectories"]},
			    {"required": ["binaryDirectories"]},
			    {"required": ["libraryDirectories"]},
			    {"required": ["configurationDirectories"]}
			],
			"additionalProperties": false,
			"properties": {
				"logDirectories": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string"
					}
				},
				"dataDirectories": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string"
					}
				},
				"binaryDirectories": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string"
					}
				},
				"libraryDirectories": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string"
					}
				},
				"configurationDirectories": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string"
					}
				}
			}
		},
		"files": {
			"type": "object",
			"anyOf": [
			    {"required": ["logFiles"]},
			    {"required": ["dataFiles"]},
			    {"required": ["binaryFiles"]},
			    {"required": ["libraryFiles"]},
			    {"required": ["configurationFiles"]}
			],
			"additionalProperties": false,
			"properties": {
				"logFiles": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string"
					}
				},
				"dataFiles": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string"
					}
				},
				"binaryFiles": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string"
					}
				},
				"libraryFiles": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string"
					}
				},
				"configurationFiles": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string"
					}
				}
			}
		}
	}
}