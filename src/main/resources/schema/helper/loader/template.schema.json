{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "The schema that is used to validate template definitions.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "desc": { "type": "string" },
    "required": { "type": "boolean" },
    "unique": { "type": "boolean" },
    "templateOf": {
      "type": "string",
      "$ref": "#/patterns/uuid"
    },
    "uuid": {
      "type": "string",
      "$ref": "#/patterns/uuid"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "$ref": "#/definitions/non-leaf"
          },
          {
            "$ref": "#/definitions/leaf"
          }
        ]
      }
    }
  },
  "required": [ "name", "desc", "templateOf", "uuid", "components" ],
  "patterns": {
    "uuid": { "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$" }
  },
  "definitions": {
    "non-leaf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "desc": { "type": "string" },
        "required": { "type": "boolean" },
        "unique": { "type": "boolean" },
        "templateOf": {
          "type": "string",
          "$ref": "#/patterns/uuid"
        },
        "uuid": {
          "type": "string",
          "$ref": "#/patterns/uuid"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "$ref": "#/definitions/non-leaf"
              },
              {
                "$ref": "#/definitions/leaf"
              }
            ]
          }
        }
      },
      "required": [ "name", "desc", "templateOf", "uuid", "components" ]
    },
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "desc": { "type": "string" },
        "required": { "type": "boolean" },
        "unique": { "type": "boolean" },
        "templateOf": {
          "type": "string",
          "$ref": "#/patterns/uuid"
        },
        "uuid": {
          "type": "string",
          "$ref": "#/patterns/uuid"
        }
      },
      "required": [ "name", "desc", "templateOf", "uuid" ]
    }
  }
}
