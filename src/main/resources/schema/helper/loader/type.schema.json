{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Schema for Structure types.",
  "type": "object",
    "required": [
      "name",
      "desc"
    ],
    "additionalProperties": false,
    "properties": {
      "uuid": {
        "$ref": "../../common.schema.json#/definitions/uuid"
      },
      "name": {
        "type": "string"
      },
      "desc": {
        "type": "string"
      },
      "checksum": {
        "type": "string"
      },
      "isa": {
        "$ref": "../../common.schema.json#/definitions/uuid"
      },
      "glyphId": {
        "type": "integer"
      },
      "implements": {
        "type": ["string", "array" ],
        "items": { "type": "string" }
      },
      "descriptors": {
        "type": "object",
        "patternProperties": {
          "^[a-zA-Z0-9]+$": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^array|boolean|integer|number|null|object|string$"
              },
              "required": {
                "type": "boolean",
                "default": false
              },
              "desc": {
                "type": "string"
              },
              "defaultValue": {
                "type": "string"
              },
              "pattern": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "desc"
            ]
          }
        },
        "additionalProperties": false
      }
    }
}
