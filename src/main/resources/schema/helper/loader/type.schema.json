{
  "id": "https://repo.raaftech.com/schema/helper/loader/type.schema.json#",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Schema for Structure types.",
  "type": "object",
    "required": [
      "uuid",
      "name",
      "desc"
    ],
    "additionalProperties": false,
    "properties": {
      "uuid": {
        "type": "string",
        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$"
      },
      "name": {
        "type": "string"
      },
      "desc": {
        "type": "string"
      },
      "isa": {
        "type": "string",
        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$"
      },
      "glyphId": {
        "type": "integer"
      },
      "descriptors": {
        "type": "object",
        "patternProperties": {
          "^[a-zA-Z0-9]+$": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^array|boolean|integer|number|null|object|string$"
              },
              "required": {
                "type": "boolean",
                "default": false
              },
              "desc": {
                "type": "string"
              },
              "defaultValue": {
                "type": "string"
              },
              "pattern": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "desc"
            ]
          }
        },
        "additionalProperties": false
      }
    }
}
