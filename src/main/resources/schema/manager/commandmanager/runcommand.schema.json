{
  "id": "https://repo.raaftech.com/schema/manager/commandmanager/runcommand.schema.json#",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Schema for every CommandManager's runCommand method.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "commander": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "command": {
      "type": "string"
    }
  },
  "required": [ "commander", "subject", "command" ]
}
