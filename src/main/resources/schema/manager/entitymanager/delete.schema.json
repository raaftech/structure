{
  "id": "https://repo.raaftech.com/schema/manager/entitymanager/delete.schema.json#",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Schema for EntityManager's delete method.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "labels": {
      "type": "array"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "includeStart": {
      "type": "boolean"
    }
  },
  "required": [ "labels", "uuid" ]
}