{
  "id": "https://repo.raaftech.com/schema/manager/entitymanager/read.schema.json#",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Schema for EntityManager's read method.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "start": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "includeStart": {
      "type": "boolean"
    }
  },
  "required": [ "labels", "start" ]
}