{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Schema for EntityManager's relate and unrelate methods.",
  "type": "object",
  "properties": {
    "from": {
      "$ref": "../../common.schema.json#/definitions/uuid"
    },
    "relation": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "to": {
      "$ref": "../../common.schema.json#/definitions/uuid"
    }
  },
  "additionalProperties": false,
  "required": ["from", "relation", "to"]
}
