{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Schema for InstrumentManager's runCapability method.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "capability": {
      "type": "string"
    },
    "uuids": {
      "type": "array",
      "items": {
        "$ref": "../../common.schema.json#/definitions/uuid"
      },
      "minItems": 1
    },
    "timeAllocated": {
      "type": "integer",
      "minimum": 0
    },
    "arguments": {
      "type": "object",
      "properties": {
        "/": {}
      },
      "patternProperties": {
        "^\\w*$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["capability", "uuids"]
}
