{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Schema for TaskManager's queueTask method.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "taskId": {
      "$ref": "../../common.schema.json#/definitions/uuid"
    },
    "sequential": {
      "type": "boolean",
      "default": false
    },
    "temporaryFiles": {
      "description": "Files that TaskManager deletes when the task is finished.",
      "type": "array",
      "items": { "type": "string" }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "timeAllocated": { "type": "integer" },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "instrumentName": { "type": "string" },
              "instrumentUuid": { "type": "string" },
              "originName": { "type": "string" },
              "originUuid": { "type": "string" },
              "capability": { "type": "string" },
              "timeAllocated": {
                "type": "integer",
                "minimum": 0
              },
              "stateMap": {
                "type": "object",
                "patternProperties": {
                  "^([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$": {
                    "$ref": "#/definitions/state"
                  }
                },
                "minProperties": 1,
                "additionalProperties": false
              }
            },
            "required": ["instrumentName", "instrumentUuid", "originName", "originUuid", "capability"]
          }
        },
        "required": ["command"]
      }
    }
  },
  "required": ["jobs"],
  "definitions": {
    "state": {
      "type": "object",
      "required": ["code", "interpretation", "description"],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "description": "A code representing the \"goodness\" of the result, 0 being \"good\", 2 being \"bad\"."
        },
        "interpretation": {
          "type": "string",
          "description": "A short word conveying the meaning of \"stateCode\", e.g. \"OK\", \"MAYBE\", \"NOK\""
        },
        "description": {
          "type": "string",
          "description": "A longer description of the reason for the status code."
        }
      }
    }
  }
}
