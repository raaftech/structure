{
  "id": "https://repo.raaftech.com/schema/manager/taskmanager/queuetask.schema.json#",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Schema for TaskManager's queueTask method.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "sequential": {
      "type": "boolean",
      "default": false
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "timeAllocated": { "type": "integer" },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "controller": { "type": "string" },
              "originName": { "type": "string" },
              "originUuid": { "type": "string" },
              "capability": { "type": "string" }
            },
            "required": [ "controller", "originName", "originUuid", "capability" ]
          }
        },
        "required": [ "command" ]
      }
    }
  },
  "required": [ "jobs" ]
}