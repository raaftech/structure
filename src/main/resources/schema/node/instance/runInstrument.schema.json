{
  "id": "https://repo.raaftech.com/schema/node/instancenode/runInstrument.schema.json#",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Schema for every InstanceActor's runInstrument method.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "instrument": {
      "type": "string"
    },
    "timeAllocated": {
      "type": "integer",
      "minimum": 0
    },
    "arguments": {
      "type": "object",
      "properties": {
        "/": {}
      },
      "patternProperties": {
        "^\\w*$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [ "instrument" ]
}
