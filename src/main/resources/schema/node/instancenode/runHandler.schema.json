{
  "id": "https://repo.raaftech.com/schema/node/instancenode/runHandler.schema.json#",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Schema for every InstanceNodeActor's runHandler method.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "handler": {
      "type": "string"
    },
    "interactive": {
      "type": "object",
      "properties": {
        "/": {}
      },
      "patternProperties": {
        "^\\w*$": {
          "type": "string",
          "pattern": "^[\\w \\-:.\\/\\.]*$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [ "handler" ]
}