{
    "id": "https://repo.raaftech.com/schema/repository/findByUuid.json#",
    "$schema": "http://json-schema.org/draft-04/schema#",
    "description": "Schema for the findByUuid method every repository inherits.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "uuid": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$"
        }
    },
    "required": [ "uuid" ]
}