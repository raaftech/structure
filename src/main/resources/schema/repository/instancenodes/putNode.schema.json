{
    "id": "https://repo.raaftech.com/schema/repository/instancenodes/putNode.schema.json#",
    "$schema": "http://json-schema.org/draft-04/schema#",
    "description": "Schema for the InstanceNode repository's putNode method.",
    "type": "object",
    "additionalProperties": true,
    "properties": {
        "node": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89aAbB][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "name": {
            "type": "string"
        },
        "desc": {
			"type": "string"
        }
    },
    "required": [ "node", "name", "desc" ]
}