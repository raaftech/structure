{
  "type": "Controller",
  "name": "IputilsPingCheckable",
  "desc": "Provide a check to IP addresses using ping..",
  "meta": {
    "uuid": "2a77cdd9-0958-4653-8f4b-59ee03e38ad0",
    "relations": {
      "HAS_INSTRUMENT": {
        "direction": "incoming",
        "uuids": [
          "6619adef-3bcb-4e32-bfec-d235a7bf3e29"
        ]
      },
      "HANDLES": {
        "direction": "outgoing",
        "uuids": [
          "f7fbe917-9d49-4df5-95f6-6e132067a424"
        ]
      },
      "GIVES_CAPABILITY": {
        "direction": "outgoing",
        "uuids": [
          "b3cfd296-1090-43c0-ac2e-00e5d7fe7779"
        ]
      },
      "INSTANCE_OF": {
        "direction": "outgoing",
        "uuids": [
          "f482204e-7d63-45ca-96c9-10a7cc2783da"
        ]
      }
    }
  },
  "data": {
    "instrumentType": "controller",
    "subjectIsLocal": false,
    "arguments": {
      "ipv4address": {
        "value": {
          "from": "origin",
          "type": "type.configuration.ipaddress.ipv4address",
          "strategy": "useFirst",
          "onError": "fail"
        },
        "canBeUserSupplied": false,
        "isOptional": false
      },
      "interval": {
        "value": {
          "from": "static",
          "type": "string",
          "matches": "[0-9]+",
          "strategy": "mustBeOne"
        },
        "canBeUserSupplied": true,
        "isOptional": true
      },
      "count": {
        "value": {
          "from": "static",
          "type": "string",
          "matches": "[0-9]+",
          "defaultValue": "4",
          "strategy": "mustBeOne"
        },
        "canBeUserSupplied": true,
        "isOptional": true
      },
      "timeout": {
        "value": {
          "from": "static",
          "type": "string",
          "matches": "[0-9]+",
          "strategy": "mustBeOne"
        },
        "canBeUserSupplied": true,
        "isOptional": true
      }
    }
  },
  "file": {
    "dataSchema": {
      "encoding": "text",
      "format": "json",
      "path": "../../types/schemas/controller.schema.json"
    },
    "templateFile": {
      "encoding": "text",
      "format": "hbs",
      "path": "pingcheckable.hbs.sh"
    }
  }
}