[ ca ]
default_ca              = CA_default

[ CA_default ]
dir                     = .
default_days            = 365
default_md              = md5
preserve                = no
email_in_dn             = no
nameopt                 = default_ca
certopt                 = default_ca
policy                  = policy_match
copy_extensions         = copy

[ policy_match ]
countryName             = match
stateOrProvinceName     = match
organizationName        = match
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

[ req ]
default_bits            = 1024
default_keyfile         = CERTNAME.pem
distinguished_name      = req_distinguished_name
attributes              = req_attributes
prompt                  = no
output_password         = system
input_password          = system
req_extensions          = v3_req
x509_extensions         = v3_req

[ req_distinguished_name ]
C                       = ORGANIZATION_COUNTRY
ST                      = ORGANIZATION_STATE
L                       = ORGANIZATION_CITY
O                       = ORGANIZATION_NAME
OU                      = ORGANIZATION_DEPARTMENT
CN                      = CERTNAME.DOMAIN_NAME
emailAddress            = info@DOMAIN_NAME

[ req_attributes ]
challengePassword       = system

[ v3_ca ]
basicConstraints        = CA:TRUE
subjectKeyIdentifier    = hash
authorityKeyIdentifier  = keyid:always,issuer:always

[ v3_req ]
basicConstraints = CA:FALSE
keyUsage = nonRepudiation, digitalSignature, keyEncipherment
subjectAltName          = critical,SUBJECTALTNAME_LIST

[ server ]
basicConstraints=CA:FALSE
nsCertType                      = server
nsComment                       = "OpenSSL Generated Server Certificate"
subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid,issuer:always

[ client ]
basicConstraints=CA:FALSE
nsCertType                      = client
nsComment                       = "OpenSSL Generated Client Certificate"
subjectKeyIdentifier=hash
authorityKeyIdentifier=keyid,issuer:always

