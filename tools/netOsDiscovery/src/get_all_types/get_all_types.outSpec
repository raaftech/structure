{
	"type": "object",
	"required": ["db","credentials"],
	"properties": {
		"db": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object"
			}
		},
		"credentials": {
			"type": "object",
			"required": ["id"],
			"properties": {
				"id": {"type": "string"}
			},
			"additionalProperties": true
		}
	},
	"additionalProperties": false
}
